# ==============================================================================
# Configuración del Entorno - AsistPy
# Copia este archivo como .env y ajusta los valores según tu infraestructura
# ==============================================================================

# Entorno de ejecución: development | testing | production
APP_ENV=development
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Persistencia y Base de Datos
# ------------------------------------------------------------------------------
# Motores soportados: memory | sqlite | postgres | mysql | sqlserver | mongo
PERSISTENCE_BACKEND=sqlite

# Cadena de conexión (DATABASE_URL)
# Nota: Si usas 'sqlite', por defecto se usará sqlite:///asistpy.db si se omite.
# Ejemplos según el motor:
# SQLite:
DATABASE_URL=sqlite:///asistpy.db

# PostgreSQL (requiere extra 'asistpy[postgres]' / psycopg):
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/asistpy

# MySQL / MariaDB (requiere extra 'asistpy[mysql]' / pymysql):
# DATABASE_URL=mysql+pymysql://asistpy:asistpy@localhost:3306/asistpy

# SQL Server (requiere extra 'asistpy[sqlserver]' / pyodbc):
# DATABASE_URL=mssql+pyodbc://sa:YourStrongPassword123!@localhost:1433/asistpy?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# MongoDB (requiere extra 'asistpy[mongo]' / pymongo):
# MONGODB_URI=mongodb://root:example@localhost:27017
# MONGODB_DB_NAME=asistpy

# ------------------------------------------------------------------------------
# Configuración de Reloj Biométrico ZKTeco (Protocolo TCP Standalone)
# ------------------------------------------------------------------------------
ZK_DEVICE_IP=192.168.0.233
ZK_DEVICE_PORT=4370
ZK_TIMEOUT=60

# ------------------------------------------------------------------------------
# Sincronización Masiva / Orquestador (SyncAllActiveDevices)
# ------------------------------------------------------------------------------
# Filtrar sincronización por sucursal específica (opcional, dejar vacío para todas)
# SYNC_BRANCH_ID=1
# Detener ejecución al primer fallo en un reloj (true) o continuar con los demás (false)
SYNC_STOP_ON_ERROR=false

